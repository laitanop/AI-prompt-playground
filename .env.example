# Get your API key from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — used by the RAG section to generate real text embeddings via Voyage AI
# (Anthropic's recommended embeddings provider; the Claude API has no embeddings
# endpoint). The free tier covers this demo comfortably: https://www.voyageai.com
# If left unset, the RAG demo falls back to a local lexical (keyword-overlap)
# vector so the page still runs — just with less accurate semantic matching.
VOYAGE_API_KEY=
